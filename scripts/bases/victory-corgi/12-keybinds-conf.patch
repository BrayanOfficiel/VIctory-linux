+/// How often the poll thread looks at the conf file's time again.
+const RECHECK: Duration = Duration::from_secs(1);
+
+/// The mapping in effect, with its file: read once at startup, then again
+/// whenever the file's time changes, so editing it takes hold while the
+/// title runs. Checks happen on the poll thread; the mutex is only there
+/// for the `static`.
+struct Live {
+    path: Option<PathBuf>,
+    mapping: Mapping,
+    mtime: Option<SystemTime>,
+    checked: Option<Instant>,
+}
+
+impl Live {
+    /// Resolves the file and reads it, or settles on the defaults.
+    fn start() -> Live {
+        let mut live = Live {
+            path: resolve_conf(),
+            mapping: Mapping::default(),
+            mtime: None,
+            checked: Some(Instant::now()),
+        };
+        if live.path.is_some() {
+            live.reload();
+        }
+        live
+    }
+
+    /// The current mapping; checks the file at most once a second.
+    fn get(&mut self, now: Instant) -> &Mapping {
+        if self.checked.is_some_and(|at| now - at < RECHECK) {
+            return &self.mapping;
+        }
+        self.checked = Some(now);
+        if let Some(path) = &self.path
+            && let Ok(mtime) = std::fs::metadata(path).and_then(|m| m.modified())
+            && Some(mtime) != self.mtime
+        {
+            self.reload();
+        }
+        &self.mapping
+    }
+
+    /// Re-reads the file: a bad line warns and keeps its default; a file
+    /// that cannot be read keeps the mapping as it was.
+    fn reload(&mut self) {
+        let Some(path) = &self.path else {
+            return;
+        };
+        let Ok(text) = std::fs::read_to_string(path) else {
+            if self.mtime.is_some() {
+                tracing::warn!(file = %path.display(), "keybinds unreadable, keeping the mapping");
+            }
+            self.mtime = None;
+            return;
+        };
+        let (mapping, warns) = Mapping::load(&text);
+        for w in &warns {
+            tracing::warn!(file = %path.display(), "keybinds: {w}");
+        }
+        self.mtime = std::fs::metadata(path).and_then(|m| m.modified()).ok();
+        tracing::info!(file = %path.display(), keys = mapping.buttons.len(), "keybinds loaded");
+        self.mapping = mapping;
+    }
+}
+
+/// The conf path: `VICTORY_KEYBINDS` first, else a `keybinds.conf` next
+/// to the executable, else nothing, and the defaults stand.
+fn resolve_conf() -> Option<PathBuf> {
+    if let Some(list) = std::env::var_os("VICTORY_KEYBINDS") {
+        let path = PathBuf::from(list);
+        if !path.is_file() {
+            tracing::warn!(file = %path.display(), "VICTORY_KEYBINDS points at no file; the defaults stand");
+        }
+        return Some(path);
+    }
+    let beside = std::env::current_exe()
+        .ok()?
+        .parent()?
+        .join("keybinds.conf");
+    beside.is_file().then_some(beside)
+}
+
+static LIVE: LazyLock<Mutex<Live>> = LazyLock::new(|| Mutex::new(Live::start()));
+
+/// The keyboard mapping the stand-in pad uses right now.
+fn mapping() -> Mapping {
+    lock(&LIVE).get(Instant::now()).clone()
+}
