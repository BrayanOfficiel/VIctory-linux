+/// A keyboard key by name, as `keybinds.conf` and `VICTORY_KEYS` spell it:
+/// a letter or digit, or `Enter`, `Esc`, `Tab`, `Backspace`, `Space`, an
+/// arrow, `Shift`, `Ctrl`, `Alt`, `Home`, `End`, `PageUp`, `PageDown`,
+/// `Insert`, `Delete`, `Menu`, or `F1` to `F12`.
+fn key_vk(name: &str) -> Option<u8> {
+    let lower = name.to_ascii_lowercase();
+    if lower.len() == 1 && lower.as_bytes()[0].is_ascii_alphanumeric() {
+        return Some(lower.as_bytes()[0].to_ascii_uppercase());
+    }
+    if let Some(f) = lower.strip_prefix('f')
+        && let Ok(n) = f.parse::<u32>()
+        && (1..=12).contains(&n)
+    {
+        return Some(0x70 + n as u8 - 1);
+    }
+    let vk = match lower.as_str() {
+        "enter" | "return" => 0x0D,
+        "esc" | "escape" => 0x1B,
+        "tab" => 0x09,
+        "backspace" | "back" => 0x08,
+        "space" => 0x20,
+        "up" => 0x26,
+        "down" => 0x28,
+        "left" => 0x25,
+        "right" => 0x27,
+        "shift" => 0x10,
+        "ctrl" => 0x11,
+        "alt" => 0x12,
+        "home" => 0x24,
+        "end" => 0x23,
+        "pageup" | "pgup" => 0x21,
+        "pagedown" | "pgdn" => 0x22,
+        "insert" => 0x2D,
+        "delete" | "del" => 0x2E,
+        "menu" => 0x5D,
+        _ => return None,
+    };
+    Some(vk)
+}
+
+/// The stand-in pad's keyboard mapping: which key presses which button,
+/// and which key drives each analog action. A zero virtual key means the
+/// action is unbound. Several keys may share a button; analog actions take
+/// one key each.
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct Mapping {
+    /// (virtual key, button bit); a button may appear once per bound key.
+    buttons: Vec<(u8, u32)>,
+    left_trigger: u8,
+    right_trigger: u8,
+    left_up: u8,
+    left_down: u8,
+    left_left: u8,
+    left_right: u8,
+    right_up: u8,
+    right_down: u8,
+    right_left: u8,
+    right_right: u8,
+}
+
+impl Default for Mapping {
+    /// The README table: `FALLBACK_BUTTONS` for the buttons, W/A/S/D and
+    /// I/J/K/L for the sticks, Z and C for the triggers.
+    fn default() -> Self {
+        Mapping {
+            buttons: FALLBACK_BUTTONS.to_vec(),
+            left_trigger: b'Z',
+            right_trigger: b'C',
+            left_up: b'W',
+            left_down: b'S',
+            left_left: b'A',
+            left_right: b'D',
+            right_up: b'I',
+            right_down: b'K',
+            right_left: b'J',
+            right_right: b'L',
+        }
+    }
+}
+
+impl Mapping {
+    /// Reads `keybinds.conf` text: one `Action = Key...` per line, `#`
+    /// starts a comment, several keys may share a button, and an empty
+    /// value unbinds. A line overrides its action's default; an unknown
+    /// name warns and leaves that action alone (so a line whose keys are
+    /// all nonsense keeps the default rather than silently unbinding).
+    fn load(text: &str) -> (Self, Vec<String>) {
+        let mut map = Self::default();
+        let mut warns = Vec::new();
+        for (at, line) in text.lines().enumerate() {
+            let line = line.split('#').next().unwrap_or("").trim();
+            if line.is_empty() {
+                continue;
+            }
+            let Some((action, keys)) = line.split_once('=') else {
+                warns.push(format!("line {}: not an assignment", at + 1));
+                continue;
+            };
+            let mut bound = Vec::new();
+            for name in keys.split([' ', ',']).filter(|k| !k.trim().is_empty()) {
+                match key_vk(name.trim()) {
+                    Some(vk) => bound.push(vk),
+                    None => warns.push(format!("line {}: unknown key {}", at + 1, name.trim())),
+                }
+            }
+            let named = !keys.trim().is_empty();
+            if named && bound.is_empty() {
+                continue; // every key was nonsense; the default stands
+            }
+            let bind = |map: &mut Self, bit: u32| {
+                map.buttons.retain(|(_, b)| *b != bit);
+                map.buttons.extend(bound.iter().map(|vk| (*vk, bit)));
+            };
+            let mut analog = |slot: &mut u8| {
+                if bound.len() > 1 {
+                    warns.push(format!("line {}: one key per analog action", at + 1));
+                }
+                *slot = *bound.first().unwrap_or(&0);
+            };
+            match action.trim() {
+                "A" => bind(&mut map, A),
+                "B" => bind(&mut map, B),
+                "X" => bind(&mut map, X),
+                "Y" => bind(&mut map, Y),
+                "LB" => bind(&mut map, LEFT_SHOULDER),
+                "RB" => bind(&mut map, RIGHT_SHOULDER),
+                "LS" | "LeftStick" | "LeftStickClick" => bind(&mut map, LEFT_STICK),
+                "RS" | "RightStick" | "RightStickClick" => bind(&mut map, RIGHT_STICK),
+                "Start" | "Menu" => bind(&mut map, MENU),
+                "View" | "Back" => bind(&mut map, VIEW),
+                "Up" | "DPadUp" => bind(&mut map, UP),
+                "Down" | "DPadDown" => bind(&mut map, DOWN),
+                "Left" | "DPadLeft" => bind(&mut map, LEFT),
+                "Right" | "DPadRight" => bind(&mut map, RIGHT),
+                "LT" | "LeftTrigger" => analog(&mut map.left_trigger),
+                "RT" | "RightTrigger" => analog(&mut map.right_trigger),
+                "LeftStickUp" => analog(&mut map.left_up),
+                "LeftStickDown" => analog(&mut map.left_down),
+                "LeftStickLeft" => analog(&mut map.left_left),
+                "LeftStickRight" => analog(&mut map.left_right),
+                "RightStickUp" => analog(&mut map.right_up),
+                "RightStickDown" => analog(&mut map.right_down),
+                "RightStickLeft" => analog(&mut map.right_left),
+                "RightStickRight" => analog(&mut map.right_right),
+                other => warns.push(format!("line {}: unknown action {other}", at + 1)),
+            }
+        }
+        (map, warns)
+    }
+}
