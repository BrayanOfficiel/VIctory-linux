+    #[test]
+    fn key_names_parse_as_the_conf_spells_them() {
+        assert_eq!(key_vk("w"), Some(b'W'));
+        assert_eq!(key_vk("7"), Some(b'7'));
+        assert_eq!(key_vk("Enter"), Some(0x0D));
+        assert_eq!(key_vk("Backspace"), Some(0x08));
+        assert_eq!(key_vk("Space"), Some(0x20));
+        assert_eq!(key_vk("up"), Some(0x26));
+        assert_eq!(key_vk("F1"), Some(0x70));
+        assert_eq!(key_vk("F12"), Some(0x7B));
+        assert_eq!(key_vk("F13"), None);
+        assert_eq!(key_vk("nope"), None);
+    }
+
+    #[test]
+    fn conf_lines_override_defaults_and_nonsense_keeps_them() {
+        let (map, warns) =
+            Mapping::load("# mine\nA = K, L\nLeftStickUp = Up\nBogus = Z\nY = Wat\nRT =\n");
+        // "Bogus" is no action, "Wat" is no key; both warn, nothing else.
+        assert_eq!(warns.len(), 2, "{warns:?}");
+        // A takes K and now; the default Enter binds nothing anymore.
+        assert_eq!(fallback_with(&map, &[key(b'K')]).buttons, A);
+        assert_eq!(fallback_with(&map, &[key(0x0D)]).buttons, 0);
+        // An unmapped action keeps its default (Y is still the Y key).
+        assert_eq!(fallback_with(&map, &[key(b'Y')]).buttons, Y);
+        // The stick took the arrow key; the trigger line unbound C.
+        assert_eq!(fallback_with(&map, &[key(0x26)]).left_y, 1.0);
+        assert_eq!(fallback_with(&map, &[key(b'W')]).left_y, 0.0);
+        assert_eq!(fallback_with(&map, &[key(b'C')]).right_trigger, 0.0);
+        assert_eq!(fallback_with(&map, &[key(b'Z')]).left_trigger, 1.0);
+    }
+
+    #[test]
+    fn the_conf_reloads_when_the_file_changes() {
+        let dir = std::env::temp_dir().join(format!("victory-keybinds-{}", std::process::id()));
+        let path = dir.join("keybinds.conf");
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(&path, "A = K\n").unwrap();
+        let mut live = Live {
+            path: Some(path.clone()),
+            mapping: Mapping::default(),
+            mtime: None,
+            checked: None,
+        };
+        let at = Instant::now();
+        assert_eq!(fallback_with(live.get(at), &[key(b'K')]).buttons, A);
+        assert_eq!(fallback_with(live.get(at), &[key(0x0D)]).buttons, 0);
+        std::fs::write(&path, "A = L\n").unwrap();
+        // inside the recheck second, the file is not looked at again
+        assert_eq!(fallback_with(live.get(at), &[key(b'K')]).buttons, A);
+        // past it, the new file is in effect
+        let later = at + RECHECK * 2;
+        assert_eq!(fallback_with(live.get(later), &[key(b'L')]).buttons, A);
+        assert_eq!(fallback_with(live.get(later), &[key(b'K')]).buttons, 0);
+        std::fs::remove_dir_all(&dir).ok();
+    }
